# Public app URL used by generated metadata and deployment docs.
VITE_APP_URL="http://localhost:3000"

# Comma-separated emails that can open the client-side admin panel locally.
# Production writes are also protected by Firebase custom claims in firestore.rules/storage.rules.
VITE_ADMIN_EMAILS="admin@example.com"

# Localhost dev preview lets any Google-signed-in account open the admin UI.
# Production still requires VITE_ADMIN_EMAILS and Firebase admin custom claims.
VITE_ALLOW_LOCAL_ADMIN_PREVIEW="true"
