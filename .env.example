# Public app URL used by generated metadata and deployment docs.
VITE_APP_URL="http://localhost:3000"

# Comma-separated emails used to show approved admin UI.
# Real data access is still enforced by Firestore rules/custom claims.
VITE_ADMIN_EMAILS="biolabjahid@gmail.com,sarkerramjan2015@gmail.com"

# Optional UI-only localhost preview bypass. Keep false unless actively designing
# admin screens; uploads and production writes still require a verified admin.
VITE_ALLOW_LOCAL_ADMIN_PREVIEW="false"

# Local development only: restricted unsigned Cloudinary preset.
VITE_CLOUDINARY_CLOUD_NAME="dubmtcs5l"
VITE_CLOUDINARY_UPLOAD_PRESET="biolab_unsigned"

# Vercel server variables for production signed uploads. Do not prefix these
# with VITE_ and never expose CLOUDINARY_API_SECRET in browser code.
ADMIN_EMAILS="biolabjahid@gmail.com,sarkerramjan2015@gmail.com"
FIREBASE_WEB_API_KEY="your-firebase-web-api-key"
FIREBASE_PROJECT_ID="your-firebase-project-id"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
